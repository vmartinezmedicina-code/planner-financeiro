// Planner Financeiro - schema do banco de dados
// SQLite local em desenvolvimento; Turso (libSQL) em produção.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Usuários (apenas 2 contas fixas, sem auto-cadastro)
// ---------------------------------------------------------------------------
model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  avatarColor    String    @default("#6366f1")
  createdAt      DateTime  @default(now())
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  // V2: incrementado ao trocar a senha; sessões (JWT) com versão antiga são rejeitadas.
  sessionVersion Int       @default(0)
  householdId    String?
  household      Household? @relation(fields: [householdId], references: [id])
  member         HouseholdMember?

  transactions         Transaction[]
  investments          Investment[]
  plannedValues        PlannedValue[]
  installmentPurchases InstallmentPurchase[]
}

// ---------------------------------------------------------------------------
// V2 — Família. Uma Household agrupa usuários (com login) e membros
// financeiros (com ou sem login: "Helena", "Casa"...). Todo registro
// financeiro pertence a uma família; as rotas filtram pelo household da sessão.
// ---------------------------------------------------------------------------
model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users                User[]
  members              HouseholdMember[]
  banks                Bank[]
  creditCards          CreditCard[]
  categories           Category[]
  plannedValues        PlannedValue[]
  transactions         Transaction[]
  installmentPurchases InstallmentPurchase[]
  investments          Investment[]
  invoices             CreditCardInvoice[]
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id])
  color       String    @default("#6366f1")
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  transactions Transaction[]

  @@index([householdId])
}

// ---------------------------------------------------------------------------
// Bancos / contas (saldo inicial + saldo atual calculado pelos lançamentos)
// ---------------------------------------------------------------------------
model Bank {
  id                  String   @id @default(cuid())
  name                String
  initialBalance      Float    @default(0) // legado (espelho) — fonte da verdade: initialBalanceCents
  initialBalanceCents Int      @default(0)
  color               String   @default("#6366f1")
  order               Int      @default(0)
  createdAt           DateTime @default(now())
  householdId         String?
  household           Household? @relation(fields: [householdId], references: [id])

  transactions Transaction[]
  paidInvoices CreditCardInvoice[]

  @@index([householdId])
}

// ---------------------------------------------------------------------------
// Cartões de crédito (fatura calculada pelos lançamentos vinculados)
// ---------------------------------------------------------------------------
model CreditCard {
  id          String   @id @default(cuid())
  name        String
  institution String?
  limit       Float?
  closingDay  Int? // dia de fechamento da fatura (1-31)
  dueDay      Int? // dia de vencimento da fatura (1-31)
  color       String   @default("#ec4899")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id])

  transactions         Transaction[]
  installmentPurchases InstallmentPurchase[]
  invoices             CreditCardInvoice[]

  @@index([householdId])
}

// ---------------------------------------------------------------------------
// V2 — Fatura de cartão. Cada compra no cartão (CARD_PURCHASE) pertence a
// exatamente uma fatura, definida pelo dia de fechamento do cartão. Pagar a
// fatura cria um lançamento CARD_PAYMENT na conta escolhida (sai do saldo,
// mas NÃO é despesa — a despesa já foi contada na compra).
// ---------------------------------------------------------------------------
enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  PARTIAL
  OVERDUE
}

model CreditCardInvoice {
  id                   String        @id @default(cuid())
  householdId          String?
  household            Household?    @relation(fields: [householdId], references: [id])
  creditCardId         String
  creditCard           CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  referenceYear        Int
  referenceMonth       Int // 1-12
  openingDate          DateTime
  closingDate          DateTime
  dueDate              DateTime
  status               InvoiceStatus @default(OPEN) // OPEN/CLOSED/OVERDUE são derivados das datas na leitura; PAID/PARTIAL persistidos
  totalCents           Int           @default(0) // cache: soma das compras; recalculado pelo serviço
  paidCents            Int           @default(0)
  paidAt               DateTime?
  paymentBankId        String?
  paymentBank          Bank?         @relation(fields: [paymentBankId], references: [id])
  paymentTransactionId String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  transactions Transaction[]

  @@unique([creditCardId, referenceYear, referenceMonth])
  @@index([householdId])
  @@index([dueDate])
}

// ---------------------------------------------------------------------------
// Categorias / Subcategorias (hierarquia recursiva ilimitada)
// ---------------------------------------------------------------------------
enum CategoryType {
  RECEITA
  DESPESA
}

model Category {
  id        String       @id @default(cuid())
  name      String
  type      CategoryType
  order     Int          @default(0)
  parentId  String?
  parent    Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[]   @relation("CategoryTree")
  createdAt DateTime     @default(now())
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id])

  plannedValues        PlannedValue[]
  transactions         Transaction[]
  installmentPurchases InstallmentPurchase[]

  @@index([parentId])
  @@index([type])
  @@index([householdId])
}

// ---------------------------------------------------------------------------
// Valores planejados (orçado) por categoria/mês/ano
// ---------------------------------------------------------------------------
model PlannedValue {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  year       Int
  month       Int // 1-12
  amount      Float    @default(0) // legado (espelho) — fonte da verdade: amountCents
  amountCents Int      @default(0)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id])
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, year, month])
  @@index([year, month])
  @@index([householdId])
}

// ---------------------------------------------------------------------------
// Lançamentos (realizado)
// ---------------------------------------------------------------------------
enum TransactionStatus {
  PENDENTE
  PAGO
  CONFIRMADO
}

// Forma de pagamento: define para onde o lançamento é direcionado.
// CREDITO -> entra na fatura do cartão (creditCardId), NUNCA mexe no saldo do banco.
// DEBITO / PIX / DINHEIRO -> sai direto do saldo do banco (bankId), NUNCA vai para fatura.
enum PaymentMethod {
  DEBITO
  CREDITO
  PIX
  DINHEIRO
}

// V2: semântica do lançamento (ver docs/DATA-MODEL-V2.md).
// INCOME/EXPENSE: consumo via conta. CARD_PURCHASE: despesa no cartão (vai para a fatura).
// CARD_PAYMENT: pagamento da fatura (sai da conta, NÃO é despesa). TRANSFER: entre contas
// próprias (par ligado por transferGroupId, NÃO é receita/despesa). ADJUSTMENT: correção de saldo.
enum TransactionKind {
  INCOME
  EXPENSE
  TRANSFER
  CARD_PURCHASE
  CARD_PAYMENT
  ADJUSTMENT
}

// V2: de onde veio o lançamento (auditoria / importação).
enum TransactionSource {
  MANUAL
  TEXT_AI
  IMAGE
  PDF
  CSV
  IMPORT
  SYSTEM
}

model Transaction {
  id                    String               @id @default(cuid())
  eventDate             DateTime // data do evento (compra)
  settlementDate        DateTime? // data da efetivação (pagamento)
  categoryId            String?
  category              Category?            @relation(fields: [categoryId], references: [id])
  paymentMethod         PaymentMethod        @default(DEBITO)
  bankId                String?
  bank                  Bank?                @relation(fields: [bankId], references: [id])
  creditCardId          String?
  creditCardRef         CreditCard?          @relation(fields: [creditCardId], references: [id])
  description           String
  amount                Float // legado (espelho) — fonte da verdade: amountCents. positivo = receita, negativo = despesa
  amountCents           Int                  @default(0)
  kind                  TransactionKind      @default(EXPENSE)
  source                TransactionSource    @default(MANUAL)
  householdId           String?
  household             Household?           @relation(fields: [householdId], references: [id])
  memberId              String? // a quem pertence o gasto/receita (opcional); userId = quem lançou
  member                HouseholdMember?     @relation(fields: [memberId], references: [id])
  transferGroupId       String? // une os dois lados de uma transferência
  invoiceId             String? // fatura à qual uma CARD_PURCHASE pertence
  invoice               CreditCardInvoice?   @relation(fields: [invoiceId], references: [id])
  status                TransactionStatus    @default(PENDENTE)
  isRecurring           Boolean              @default(false)
  recurrenceRule        String? // ex: "MONTHLY"
  installmentPurchaseId String? // preenchido quando o lançamento é 1 parcela de uma compra parcelada
  installmentPurchase   InstallmentPurchase? @relation(fields: [installmentPurchaseId], references: [id], onDelete: Cascade)
  installmentNumber     Int? // número desta parcela (1, 2, 3...)
  userId                String
  user                  User                 @relation(fields: [userId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([eventDate])
  @@index([categoryId])
  @@index([status])
  @@index([bankId])
  @@index([creditCardId])
  @@index([installmentPurchaseId])
  @@index([kind])
  @@index([householdId, eventDate])
  @@index([memberId])
  @@index([transferGroupId])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Compras parceladas no cartão de crédito — o "grupo" que liga todas as
// parcelas (Transaction) geradas de uma vez. Cada parcela é um Transaction
// normal (entra na fatura do mês dela normalmente); este registro só guarda
// os dados da compra original para exibir o resumo/gráfico de parcelamentos.
model InstallmentPurchase {
  id                String     @id @default(cuid())
  description       String
  totalAmount       Float // legado (espelho) — fonte da verdade: totalAmountCents. valor total da compra (positivo)
  totalAmountCents  Int        @default(0)
  installmentsCount Int
  purchaseDate      DateTime // data da compra original
  categoryId        String?
  category          Category?  @relation(fields: [categoryId], references: [id])
  creditCardId      String
  creditCard        CreditCard @relation(fields: [creditCardId], references: [id])
  userId            String
  user              User       @relation(fields: [userId], references: [id])
  householdId       String?
  household         Household? @relation(fields: [householdId], references: [id])
  createdAt         DateTime   @default(now())

  installments Transaction[]

  @@index([creditCardId])
  @@index([categoryId])
  @@index([householdId])
}

// ---------------------------------------------------------------------------
// Investimentos
// ---------------------------------------------------------------------------
model Investment {
  id                String   @id @default(cuid())
  product           String // tipo/produto (ex: Tesouro Selic, CDB, Ações)
  institution            String
  contributedAmount      Float // legado (espelho) — fonte da verdade: contributedAmountCents
  contributedAmountCents Int      @default(0)
  contributionDate       DateTime
  currentValue           Float // legado (espelho) — fonte da verdade: currentValueCents
  currentValueCents      Int      @default(0)
  userId                 String
  user                   User     @relation(fields: [userId], references: [id])
  householdId            String?
  household              Household? @relation(fields: [householdId], references: [id])
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId])
  @@index([householdId])
}
