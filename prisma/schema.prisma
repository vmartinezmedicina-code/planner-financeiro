// Planner Financeiro - schema do banco de dados
// SQLite local em desenvolvimento; Turso (libSQL) em produção.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Usuários (apenas 2 contas fixas, sem auto-cadastro)
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarColor  String   @default("#6366f1")
  createdAt    DateTime @default(now())

  transactions         Transaction[]
  investments          Investment[]
  plannedValues        PlannedValue[]
  installmentPurchases InstallmentPurchase[]
}

// ---------------------------------------------------------------------------
// Bancos / contas (saldo inicial + saldo atual calculado pelos lançamentos)
// ---------------------------------------------------------------------------
model Bank {
  id             String   @id @default(cuid())
  name           String
  initialBalance Float    @default(0)
  color          String   @default("#6366f1")
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  transactions Transaction[]
}

// ---------------------------------------------------------------------------
// Cartões de crédito (fatura calculada pelos lançamentos vinculados)
// ---------------------------------------------------------------------------
model CreditCard {
  id          String   @id @default(cuid())
  name        String
  institution String?
  limit       Float?
  closingDay  Int? // dia de fechamento da fatura (1-31)
  dueDay      Int? // dia de vencimento da fatura (1-31)
  color       String   @default("#ec4899")
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  transactions         Transaction[]
  installmentPurchases InstallmentPurchase[]
}

// ---------------------------------------------------------------------------
// Categorias / Subcategorias (hierarquia recursiva ilimitada)
// ---------------------------------------------------------------------------
enum CategoryType {
  RECEITA
  DESPESA
}

model Category {
  id        String       @id @default(cuid())
  name      String
  type      CategoryType
  order     Int          @default(0)
  parentId  String?
  parent    Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[]   @relation("CategoryTree")
  createdAt DateTime     @default(now())

  plannedValues        PlannedValue[]
  transactions         Transaction[]
  installmentPurchases InstallmentPurchase[]

  @@index([parentId])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Valores planejados (orçado) por categoria/mês/ano
// ---------------------------------------------------------------------------
model PlannedValue {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  year       Int
  month      Int // 1-12
  amount     Float    @default(0)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, year, month])
  @@index([year, month])
}

// ---------------------------------------------------------------------------
// Lançamentos (realizado)
// ---------------------------------------------------------------------------
enum TransactionStatus {
  PENDENTE
  PAGO
  CONFIRMADO
}

// Forma de pagamento: define para onde o lançamento é direcionado.
// CREDITO -> entra na fatura do cartão (creditCardId), NUNCA mexe no saldo do banco.
// DEBITO / PIX / DINHEIRO -> sai direto do saldo do banco (bankId), NUNCA vai para fatura.
enum PaymentMethod {
  DEBITO
  CREDITO
  PIX
  DINHEIRO
}

model Transaction {
  id                    String               @id @default(cuid())
  eventDate             DateTime // data do evento (compra)
  settlementDate        DateTime? // data da efetivação (pagamento)
  categoryId            String?
  category              Category?            @relation(fields: [categoryId], references: [id])
  paymentMethod         PaymentMethod        @default(DEBITO)
  bankId                String?
  bank                  Bank?                @relation(fields: [bankId], references: [id])
  creditCardId          String?
  creditCardRef         CreditCard?          @relation(fields: [creditCardId], references: [id])
  description           String
  amount                Float // positivo = receita, negativo = despesa
  status                TransactionStatus    @default(PENDENTE)
  isRecurring           Boolean              @default(false)
  recurrenceRule        String? // ex: "MONTHLY"
  installmentPurchaseId String? // preenchido quando o lançamento é 1 parcela de uma compra parcelada
  installmentPurchase   InstallmentPurchase? @relation(fields: [installmentPurchaseId], references: [id], onDelete: Cascade)
  installmentNumber     Int? // número desta parcela (1, 2, 3...)
  userId                String
  user                  User                 @relation(fields: [userId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([eventDate])
  @@index([categoryId])
  @@index([status])
  @@index([bankId])
  @@index([creditCardId])
  @@index([installmentPurchaseId])
}

// ---------------------------------------------------------------------------
// Compras parceladas no cartão de crédito — o "grupo" que liga todas as
// parcelas (Transaction) geradas de uma vez. Cada parcela é um Transaction
// normal (entra na fatura do mês dela normalmente); este registro só guarda
// os dados da compra original para exibir o resumo/gráfico de parcelamentos.
model InstallmentPurchase {
  id                String     @id @default(cuid())
  description       String
  totalAmount       Float // valor total da compra (positivo)
  installmentsCount Int
  purchaseDate      DateTime // data da compra original
  categoryId        String?
  category          Category?  @relation(fields: [categoryId], references: [id])
  creditCardId      String
  creditCard        CreditCard @relation(fields: [creditCardId], references: [id])
  userId            String
  user              User       @relation(fields: [userId], references: [id])
  createdAt         DateTime   @default(now())

  installments Transaction[]

  @@index([creditCardId])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Investimentos
// ---------------------------------------------------------------------------
model Investment {
  id                String   @id @default(cuid())
  product           String // tipo/produto (ex: Tesouro Selic, CDB, Ações)
  institution       String
  contributedAmount Float
  contributionDate  DateTime
  currentValue      Float
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}
